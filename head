<head>
        <title>MVUnblocked</title>
    <link rel="shortcut icon" type="image/jpg" href="https://mvunblocked.com/MVLogo.ico"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
<body>

    <div id="toolbar-slot"></div>

<script>
fetch('/toolbar.html')
    .then(res => res.text())
    .then(html => {
        const slot = document.getElementById('toolbar-slot');
        slot.innerHTML = html;

        slot.querySelectorAll('script').forEach(oldScript => {
            const newScript = document.createElement('script');
            newScript.textContent = oldScript.textContent;
            document.body.appendChild(newScript);
        });
    });
</script>
